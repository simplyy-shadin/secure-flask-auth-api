# Generate long random values, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value

# Optional. Defaults to instance/users.db for local development.
DATABASE_URL=sqlite:///instance/users.db

# Development default is memory://. Use shared storage (for example Redis)
# when running multiple application workers.
RATELIMIT_STORAGE_URI=memory://
